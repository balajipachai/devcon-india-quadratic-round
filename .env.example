# Copy to .env (gitignored). Never put a private key here: import it with `cast wallet import`.
SEPOLIA_RPC_URL=
DEPLOYER=                       # address of the keystore account; it becomes the round operator
KEYSTORE_ACCOUNT=deployer
ETHERSCAN_API_KEY=              # optional; without it the source is verified on Sourcify

MEMBERS_FILE=tools/members.txt  # one eligible 0x address per line
PROJECT_RECIPIENTS=             # comma-separated 0x addresses, one per project
PROJECT_NAMES=                  # comma-separated names, same order and count
REGISTRATION_SECONDS=1800       # time between deploy and round start; projects can only be registered before it
ROUND_SECONDS=259200            # length of the contribution window
POOL_WEI=                       # matching pool funded at deploy, e.g. 1000000000000000000 for 1 ETH
